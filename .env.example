# Postgres connection string (Vercel Postgres / Neon).
# Vercel provides this automatically when you connect a Postgres database
# to your project - copy it from the Vercel dashboard's .env.local tab.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used by NextAuth to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Set to your deployed URL in production (e.g. https://your-app.vercel.app).
# For local dev, leave as-is.
NEXTAUTH_URL="http://localhost:3000"

# Optional: exchange-rate API key if you later add live conversion.
# Not required for the current single-currency-per-invoice setup.
# EXCHANGE_RATE_API_KEY=""
